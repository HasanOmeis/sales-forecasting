# The virtual environment is big and can be recreated from requirements.txt
.venv/

# Python's automatic cache files
__pycache__/

# Notebook autosave folders
.ipynb_checkpoints/



# MLflow run folders (params, metrics, plots); local only, not for GitHub
mlruns/
# MLflow's local database file (MLflow 3 can store runs here)
mlflow.db
# MLflow artifact folder some setups create
mlartifacts/

# pytest's cache folder, recreated on every test run
.pytest_cache/